record(ai, "$(P=$(IOC):NET:$(NIC)):RXR_") {
    field(DTYP, "Soft Timestamp")
    field(TSEL, "$(P=$(IOC):NET:$(NIC)):RX_.TIME") # table update time
    field(FLNK, "$(P=$(IOC):NET:$(NIC)):RX")
}
record(calc, "$(P=$(IOC):NET:$(NIC)):RX") {
    field(INPA, "$(P=$(IOC):NET:$(NIC)):RX_")
    field(INPB, "$(P=$(IOC):NET:$(NIC)):RXR_")
    # C - prev count
    # D - prev time
    # E - result
    field(INPF, "0.0009765625")
    field(CALC, "E:=(A-C)/(B-D);C:=A;D:=B;E*F")
    field(EGU , "KB/s")
    field(PREC, "1")
    field(HOPR, "")
    field(LOPR, "")
    field(HIHI, "")
    field(HIGH, "")
    field(LOW , "")
    field(LOLO, "")
    field(HHSV, "")
    field(HSV , "")
    field(LSV , "")
    field(LLSV, "")
    field(ADEL, "")
    field(TSEL, "$(P=$(IOC):NET:$(NIC)):RX_.TIME")
}
