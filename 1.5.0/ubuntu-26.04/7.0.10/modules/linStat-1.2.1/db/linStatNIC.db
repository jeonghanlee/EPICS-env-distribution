record(calc, "$(P=$(IOC):NET:$(NIC)):RX:D") {
    field(INPA, "$(P=$(IOC):NET:$(NIC)):RX:D:IP CP MS")
    field(INPB, "$(P=$(IOC):NET:$(NIC)):RX:D:DRV CP MS")
    field(CALC, "A+B")
    field(EGU , "pkt/s")
    field(PREC, "1")
}
