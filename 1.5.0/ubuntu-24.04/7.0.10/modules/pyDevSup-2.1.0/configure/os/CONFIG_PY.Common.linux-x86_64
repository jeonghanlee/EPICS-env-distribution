TARGET_CFLAGS += -fno-strict-overflow -Wsign-compare
TARGET_CXXFLAGS += -fno-strict-overflow -Wsign-compare
PY_VER := 3.12
PY_LD_VER := 3.12
PY_INCDIRS := /usr/lib/python3/dist-packages/numpy/core/include /usr/include/python3.12
PY_LIBDIRS := /usr/lib/x86_64-linux-gnu
HAVE_NUMPY := YES
HAVE_ASYNCIO := YES
HAVE_COTHREAD := NO
PY_OK := YES
