TARGET_CFLAGS += -fno-strict-overflow -Wsign-compare
TARGET_CXXFLAGS += -fno-strict-overflow -Wsign-compare
PY_VER := 3.12
PY_LD_VER := 3.12
PY_INCDIRS := /usr/lib64/python3.12/site-packages/numpy/core/include /usr/include/python3.12
PY_LIBDIRS := /usr/lib64
HAVE_NUMPY := YES
HAVE_ASYNCIO := YES
HAVE_COTHREAD := NO
PY_OK := YES
