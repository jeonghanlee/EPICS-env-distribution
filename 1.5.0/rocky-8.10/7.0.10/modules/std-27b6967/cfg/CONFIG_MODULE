ifeq (,$(_STD_INCLUDED))
_STD_INCLUDED = YES

_STD_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

ifdef T_A

_STD_DEPS := $(shell $(CONVERTRELEASE) -T $(_STD_DIR)/.. releaseTops)
_STD_DEPS := $(filter-out EPICS_BASE SUPPORT, $(_STD_DEPS))

$(foreach dep, $(_STD_DEPS), $(eval -include $($(dep))/cfg/CONFIG_MODULE))

-include $(_STD_DIR)/STD_DEPS
-include $(_STD_DIR)/STD_DEPS.local

ALL_IOC_DBDS += $(STD_IOC_DBDS)
ALL_IOC_LIBS := $(STD_IOC_LIBS) $(ALL_IOC_LIBS)
ALL_IOC_SYS_LIBS := $(STD_IOC_SYS_LIBS) $(ALL_IOC_SYS_LIBS)

endif # T_A
endif # included
