ifeq (,$(_LUA_INCLUDED))
_LUA_INCLUDED = YES

_LUA_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

ifdef T_A

_LUA_DEPS := $(shell $(CONVERTRELEASE) -T $(_LUA_DIR)/.. releaseTops)
_LUA_DEPS := $(filter-out EPICS_BASE SUPPORT, $(_LUA_DEPS))

$(foreach dep, $(_LUA_DEPS), $(eval -include $($(dep))/cfg/CONFIG_MODULE))

-include $(_LUA_DIR)/LUA_DEPS
-include $(_LUA_DIR)/LUA_DEPS.local

ALL_IOC_DBDS += $(LUA_IOC_DBDS)
ALL_IOC_LIBS := $(LUA_IOC_LIBS) $(ALL_IOC_LIBS)
ALL_IOC_SYS_LIBS := $(LUA_IOC_SYS_LIBS) $(ALL_IOC_SYS_LIBS)

endif # T_A
endif # included
