# iocsh startup script for MKS MV2 RGA
#
# Macros to pass:
# IP_ADDR - IP address
# PORT - asyn port name
# RGA_PORT - RGA_PORT port name

drvAsynIPPortConfigure("$(PORT)", "$(IP_ADDR):10014", 0, 0, 0)

mv2init("$(RGA_PORT)", "$(PORT)")

