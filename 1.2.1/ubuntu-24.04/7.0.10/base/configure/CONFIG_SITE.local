INSTALL_LOCATION=/home/vmadmin/EPICS-env-distribution/1.2.1/ubuntu-24.04/7.0.10/base
CROSS_COMPILER_TARGET_ARCHS=
LINKER_USE_RPATH = ORIGIN
EPICS_SITE_VERSION = "github.com/jeonghanlee/EPICS-env"
GENVERSIONDEFAULT = "EPICS-env-7.0.10-1.2.1-0-gb485e14"
OP_SYS_LDFLAGS += $(SHRLIB_SEARCH_DIRS:%=-Wl,-rpath-link,%)
PROD_LDFLAGS_DEFAULT += -Wl,--enable-new-dtags
PYTHON = python3
USR_CFLAGS   += -g0 -gz=zlib
USR_CXXFLAGS += -g0 -gz=zlib
USR_LDFLAGS  += -g0 -gz=zlib
